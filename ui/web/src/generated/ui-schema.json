          "title": "Side",
          "type": "string"
        },
        "stop_loss": {
          "title": "Stop Loss",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "take_profit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
