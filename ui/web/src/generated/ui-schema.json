{
  "$defs": {
    "UiAccountEventSchema": {
      "description": "Periodic full account state; session fields repeat so trimming is safe.",
      "properties": {
        "balance_usdt": {
          "title": "Balance Usdt",
          "type": "string"
        },
        "initial_balance_usdt": {
          "title": "Initial Balance Usdt",
          "type": "string"
        },
        "is_paper": {
          "title": "Is Paper",
          "type": "boolean"
        },
        "positions": {
          "items": {
            "$ref": "#/$defs/UiOpenPositionSchema"
          },
          "title": "Positions",
          "type": "array"
        },
        "prices": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prices",
          "type": "object"
        },
        "running_loops": {
          "items": {
            "type": "string"
          },
          "title": "Running Loops",
          "type": "array"
        },
        "session_started_at_ms": {
          "minimum": 0,
          "title": "Session Started At Ms",
          "type": "integer"
        },
        "ts_ms": {
          "minimum": 0,
          "title": "Ts Ms",
          "type": "integer"
        },
        "type": {
          "const": "account",
          "default": "account",
          "title": "Type",
          "type": "string"
        },
        "unrealized_pnl_usdt": {
          "title": "Unrealized Pnl Usdt",
          "type": "string"
        }
      },
      "required": [
        "type",
        "ts_ms",
        "session_started_at_ms",
        "is_paper",
        "initial_balance_usdt",
        "balance_usdt",
        "unrealized_pnl_usdt",
        "positions",
        "prices",
        "running_loops"
      ],
      "title": "UiAccountEventSchema",
      "type": "object"
    },
    "UiCandleSchema": {
      "properties": {
        "close": {
          "title": "Close",
          "type": "string"
        },
        "high": {
          "title": "High",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "string"
        },
        "open": {
          "title": "Open",
          "type": "string"
        },
        "open_time_ms": {
          "minimum": 0,
          "title": "Open Time Ms",
          "type": "integer"
        },
        "volume": {
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "open_time_ms",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "UiCandleSchema",
      "type": "object"
    },
    "UiCandlesEventSchema": {
      "description": "Closed candles for one symbol: a startup backfill batch or a single close.",
      "properties": {
        "candles": {
          "items": {
            "$ref": "#/$defs/UiCandleSchema"
          },
          "minItems": 1,
          "title": "Candles",
          "type": "array"
        },
        "interval": {
          "minLength": 1,
          "title": "Interval",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "ts_ms": {
          "minimum": 0,
          "title": "Ts Ms",
          "type": "integer"
        },
        "type": {
          "const": "candles",
          "default": "candles",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "ts_ms",
        "symbol",
        "interval",
        "candles"
      ],
      "title": "UiCandlesEventSchema",
      "type": "object"
    },
    "UiDecisionEventSchema": {
      "description": "One step of the Scout -> Analyst -> Trader pipeline or a position action.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning"
        },
        "stage": {
          "enum": [
            "scout",
            "analyst",
            "trader",
            "filter",
            "position",
            "trend",
            "gate",
            "execution"
          ],
          "title": "Stage",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "ts_ms": {
          "minimum": 0,
          "title": "Ts Ms",
          "type": "integer"
        },
        "type": {
          "const": "decision",
          "default": "decision",
          "title": "Type",
          "type": "string"
        },
        "verdict": {
          "minLength": 1,
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "type",
        "event_id",
        "ts_ms",
        "symbol",
        "stage",
        "verdict",
        "summary",
        "reasoning",
        "confidence",
        "latency_ms"
      ],
      "title": "UiDecisionEventSchema",
      "type": "object"
    },
    "UiEvent": {
      "discriminator": {
        "mapping": {
          "account": "#/$defs/UiAccountEventSchema",
          "candles": "#/$defs/UiCandlesEventSchema",
          "decision": "#/$defs/UiDecisionEventSchema",
          "gate_inputs": "#/$defs/UiGateInputsEventSchema",
          "position_closed": "#/$defs/UiPositionClosedEventSchema",
          "trade": "#/$defs/UiTradeEventSchema",
          "trend_state": "#/$defs/UiTrendStateEventSchema"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UiAccountEventSchema"
        },
        {
          "$ref": "#/$defs/UiDecisionEventSchema"
        },
        {
          "$ref": "#/$defs/UiTradeEventSchema"
        },
        {
          "$ref": "#/$defs/UiPositionClosedEventSchema"
        },
        {
          "$ref": "#/$defs/UiCandlesEventSchema"
        },
        {
          "$ref": "#/$defs/UiTrendStateEventSchema"
        },
        {
          "$ref": "#/$defs/UiGateInputsEventSchema"
        }
      ]
    },
    "UiEventMessageSchema": {
      "description": "A delta; seq is consecutive after the snapshot's seq for one connection.",
      "properties": {
        "event": {
          "$ref": "#/$defs/UiEvent"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "seq",
        "event"
      ],
      "title": "UiEventMessageSchema",
      "type": "object"
    },
    "UiGateInputsEventSchema": {
      "description": "The headline window the shadow gate would review an entry against now.",
      "properties": {
        "coin_headlines": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Coin Headlines",
          "type": "object"
        },
        "headlines": {
          "minimum": 0,
          "title": "Headlines",
          "type": "integer"
        },
        "lag_h": {
          "minimum": 0,
          "title": "Lag H",
          "type": "number"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "newest_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Newest Ms"
        },
        "prompt_sha": {
          "title": "Prompt Sha",
          "type": "string"
        },
        "reviews": {
          "minimum": 0,
          "title": "Reviews",
          "type": "integer"
        },
        "samples": {
          "minimum": 1,
          "title": "Samples",
          "type": "integer"
        },
        "ts_ms": {
          "minimum": 0,
          "title": "Ts Ms",
          "type": "integer"
        },
        "type": {
          "const": "gate_inputs",
          "default": "gate_inputs",
          "title": "Type",
          "type": "string"
        },
        "vetoes": {
          "minimum": 0,
          "title": "Vetoes",
          "type": "integer"
        },
        "window_h": {
          "minimum": 1,
          "title": "Window H",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "ts_ms",
        "model_id",
        "samples",
        "prompt_sha",
        "window_h",
        "lag_h",
        "headlines",
        "newest_ms",
        "coin_headlines",
        "reviews",
        "vetoes"
      ],
      "title": "UiGateInputsEventSchema",
      "type": "object"
    },
    "UiOpenPositionSchema": {
      "properties": {
        "entry_price": {
          "title": "Entry Price",
