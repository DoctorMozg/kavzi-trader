  "discriminator": {
    "mapping": {
      "event": "#/$defs/UiEventMessageSchema",
      "snapshot": "#/$defs/UiSnapshotMessageSchema"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/UiSnapshotMessageSchema"
    },
    {
      "$ref": "#/$defs/UiEventMessageSchema"
    }
  ],
  "title": "UiServerMessage"
}
