    "UiSnapshotSchema": {
      "description": "Full dashboard state; lists are oldest-first and bounded by UiConfigSchema.",
      "properties": {
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiAccountEventSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candle_interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candle Interval"
        },
        "candles": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/UiCandleSchema"
            },
            "type": "array"
          },
          "title": "Candles",
          "type": "object"
        },
        "closed_positions": {
          "items": {
            "$ref": "#/$defs/UiPositionClosedEventSchema"
          },
          "title": "Closed Positions",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/UiDecisionEventSchema"
          },
          "title": "Decisions",
          "type": "array"
        },
        "gate_inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiGateInputsEventSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/UiTradeEventSchema"
          },
          "title": "Trades",
          "type": "array"
        },
        "trend": {
          "anyOf": [
            {
              "$ref": "#/$defs/UiTrendStateEventSchema"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "account",
        "decisions",
        "trades",
        "closed_positions",
        "candles",
        "candle_interval",
        "trend",
        "gate_inputs"
      ],
      "title": "UiSnapshotSchema",
      "type": "object"
    },
    "UiTradeEventSchema": {
      "properties": {
