          "default": null,
          "title": "Take Profit"
        },
        "unrealized_pnl_usdt": {
          "title": "Unrealized Pnl Usdt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "symbol",
        "side",
        "quantity",
        "entry_price",
        "mark_price",
        "stop_loss",
        "take_profit",
        "unrealized_pnl_usdt",
        "leverage",
        "opened_at_ms"
      ],
      "title": "UiOpenPositionSchema",
      "type": "object"
    },
    "UiPositionClosedEventSchema": {
      "properties": {
        "close_reason": {
          "title": "Close Reason",
