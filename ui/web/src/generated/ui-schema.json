    "UiSnapshotMessageSchema": {
      "properties": {
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/UiSnapshotSchema"
        },
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Type",
